<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_dark_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Visitor Photo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivVisitorPhoto"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:src="@drawable/person_image"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <!-- Visitor Name & House -->
        <TextView
            android:id="@+id/tvVisitorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:text="John Doe"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/statusBadge"
            app:layout_constraintStart_toEndOf="@id/ivVisitorPhoto"
            app:layout_constraintTop_toTopOf="@id/ivVisitorPhoto" />

        <TextView
            android:id="@+id/tvHouseInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="House #101 - Block A"
            android:textColor="@color/text_grey"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tvTimeDate"
            app:layout_constraintStart_toStartOf="@id/tvVisitorName"
            app:layout_constraintTop_toBottomOf="@id/tvVisitorName" />

        <TextView
            android:id="@+id/tvVisitType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Guest Visit"
            android:textColor="@color/bright_azure_blue"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvVisitorName"
            app:layout_constraintTop_toBottomOf="@id/tvHouseInfo" />

        <!-- Status & Time -->
        <TextView
            android:id="@+id/statusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_valid_badge"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="ENTRY"
            android:textColor="@color/status_green"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTimeDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Oct 12, 10:42 AM"
            android:textColor="@color/text_grey"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBadge" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
