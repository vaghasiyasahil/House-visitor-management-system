<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_navy_bg"
    tools:context=".HouseOwnerDashboardActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/profileContainer"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgProfile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp"
                android:src="@drawable/person_image"
                app:shapeAppearanceOverlay="@style/CircleImage"
                app:strokeColor="@color/slate_blue_gray"
                app:strokeWidth="2dp" />

            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/online_indicator" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/profileContainer"
            app:layout_constraintEnd_toStartOf="@id/notificationContainer"
            app:layout_constraintStart_toEndOf="@id/profileContainer"
            app:layout_constraintTop_toTopOf="@id/profileContainer">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_back_home"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/owner_unit_info"
                android:textColor="@color/text_grey"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/notificationContainer"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/circle_dark_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@string/notification"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="@color/white" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/notification_dot" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Quick Pass Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="25dp"
                app:cardBackgroundColor="#0D1A2A"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#1AFFFFFF"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvQuickPassBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_blue"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Quick Pass"
                        android:textColor="@color/badge_blue_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvPreApproveTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Pre-Approve Guest"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvQuickPassBadge" />

                    <TextView
                        android:id="@+id/tvPreApproveDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Generate a secure QR code for visitor entry."
                        android:textColor="@color/text_grey"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPreApproveTitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateQR"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/bright_azure_blue"
                        android:paddingHorizontal="24dp"
                        android:text="Generate QR"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_qr_code_scanner"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvPreApproveDesc" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Manage Household Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="Manage Household"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="2"
                app:rowCount="3">

                <!-- Visitor Approval -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnVisitorApproval"
                    style="@style/DashboardSmallCard">
                    <LinearLayout
                        style="@style/DashboardSmallCardLayout"
                        android:layout_height="160dp">
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <ImageView
                                style="@style/DashboardSmallCardIcon"
                                android:backgroundTint="@color/badge_blue_bg"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/badge_blue_text" />
                        </FrameLayout>
                        <TextView style="@style/DashboardSmallCardTitle" android:text="Visitor Approval" />
                        <TextView style="@style/DashboardSmallCardDesc" android:text="Review requests" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Visitor History -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnVisitorHistory"
                    android:layout_height="160dp"
                    style="@style/DashboardSmallCard">
                    <LinearLayout style="@style/DashboardSmallCardLayout">
                        <ImageView style="@style/DashboardSmallCardIcon" android:backgroundTint="@color/badge_purple_bg" android:src="@drawable/ic_time" app:tint="@color/badge_purple_text" />
                        <TextView style="@style/DashboardSmallCardTitle" android:text="Visitor History" />
                        <TextView style="@style/DashboardSmallCardDesc" android:text="View past logs" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Announcements -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnAnnouncements"
                    android:layout_height="160dp"
                    style="@style/DashboardSmallCard">
                    <LinearLayout style="@style/DashboardSmallCardLayout">
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <ImageView
                                style="@style/DashboardSmallCardIcon"
                                android:backgroundTint="@color/badge_orange_bg"
                                android:src="@drawable/ic_announcement"
                                app:tint="@color/badge_orange_text" />
                        </FrameLayout>
                        <TextView style="@style/DashboardSmallCardTitle" android:text="Announcements" />
                        <TextView style="@style/DashboardSmallCardDesc" android:text="Community news" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Complaints -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnComplaints"
                    android:layout_height="160dp"
                    style="@style/DashboardSmallCard">
                    <LinearLayout style="@style/DashboardSmallCardLayout">
                        <ImageView
                            style="@style/DashboardSmallCardIcon"
                            android:backgroundTint="@color/badge_red_bg"
                            android:src="@drawable/ic_warning_triangle"
                            app:tint="@color/badge_red_text" />
                        <TextView style="@style/DashboardSmallCardTitle" android:text="Complaints" />
                        <TextView style="@style/DashboardSmallCardDesc" android:text="Report issues" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Block Visitor -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnBlockVisitor"
                    android:layout_height="160dp"
                    style="@style/DashboardSmallCard">
                    <LinearLayout style="@style/DashboardSmallCardLayout">
                        <ImageView
                            style="@style/DashboardSmallCardIcon"
                            android:backgroundTint="@color/badge_gray_bg"
                            android:src="@drawable/ic_block_circle"
                            app:tint="@color/badge_gray_text" />
                        <TextView style="@style/DashboardSmallCardTitle" android:text="Block Visitor" />
                        <TextView style="@style/DashboardSmallCardDesc" android:text="Security settings" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- View QR Code -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnViewQRCode"
                    android:layout_height="160dp"
                    style="@style/DashboardSmallCard">
                    <LinearLayout style="@style/DashboardSmallCardLayout">
                        <ImageView
                            style="@style/DashboardSmallCardIcon"
                            android:backgroundTint="@color/badge_green_bg"
                            android:src="@drawable/ic_qr_code_scanner"
                            app:tint="@color/badge_green_text" />
                        <TextView style="@style/DashboardSmallCardTitle" android:text="View QR Code" />
                        <TextView style="@style/DashboardSmallCardDesc" android:text="Manage entry" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>




            </androidx.gridlayout.widget.GridLayout>

            <!-- Recent Activity Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pending_request"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />


            </RelativeLayout>

            <!-- Recent Activity Item (Mock) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                app:cardBackgroundColor="@color/card_dark_bg"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="15dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivActivityIcon"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/person_image"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <View
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/online_indicator"
                        app:layout_constraintBottom_toBottomOf="@id/ivActivityIcon"
                        app:layout_constraintEnd_toEndOf="@id/ivActivityIcon" />

                    <TextView
                        android:id="@+id/tvActivityTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:text="Delivery: Amazon"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/tvActivityStatus"
                        app:layout_constraintStart_toEndOf="@id/ivActivityIcon"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvActivitySubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Today, 10:45 AM • Gate 1"
                        android:textColor="@color/text_grey"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/tvActivityStatus"
                        app:layout_constraintStart_toStartOf="@id/tvActivityTitle"
                        app:layout_constraintTop_toBottomOf="@id/tvActivityTitle" />

                    <TextView
                        android:id="@+id/tvActivityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_valid_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Allowed"
                        android:textColor="@color/badge_green_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>